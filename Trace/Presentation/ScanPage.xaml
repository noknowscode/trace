<Page x:Class="Trace.Presentation.ScanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Trace.Presentation.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

    <!--
        A form, so the SafeArea control: with SoftInput it brings its own ScrollViewer and keeps the
        code field above an on-screen keyboard. The form is one column: full width with 16 px sides
        on a phone, FormMaxWidth beside the rail from Normal, centred from Widest like the other
        destinations' columns.
    -->
    <utu:SafeArea Insets="VisibleBounds,SoftInput" IsTabStop="False">
            <StackPanel Spacing="{StaticResource Space200}"
                        Padding="{utu:Responsive Narrow={StaticResource Space200Thickness}, Normal={StaticResource Space300Thickness}}"
                        MaxWidth="{StaticResource FormMaxWidth}"
                        HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Left, Widest=Center}">

                <controls:PageHeader Eyebrow="IDENTIFY"
                                     Title="Scan"
                                     Supporting="Present the tag on the machine, or type the code from the nameplate." />

                <!-- Viewfinder. Stands in for the camera preview on this build. -->
                <Border Style="{StaticResource CardSurface}"
                        Background="{ThemeResource SurfaceVariantBrush}"
                        MinHeight="{StaticResource ViewfinderMinHeight}">
                    <Grid>
                        <Viewbox Width="{StaticResource ViewfinderGlyphSize}"
                                 Height="{StaticResource ViewfinderGlyphSize}"
                                 Opacity="{StaticResource LowOpacity}">
                            <PathIcon Data="{StaticResource IconScan}" />
                        </Viewbox>
                        <TextBlock Style="{StaticResource SupportingText}"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Text="Camera preview is simulated in this build. Scan presents the next tagged asset." />
                    </Grid>
                </Border>

                <Button Style="{StaticResource FilledButtonStyle}"
                        HorizontalAlignment="Stretch"
                        MinHeight="{StaticResource ControlHeightMediumLarge}"
                        Command="{Binding ScanTag}"
                        Content="Scan a tag"
                        AutomationProperties.Name="Scan a tag" />

                <Border Style="{StaticResource CardSurface}">
                    <StackPanel Spacing="{StaticResource Space150}">
                        <TextBlock Text="Enter a code" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Style="{StaticResource SupportingText}"
                                   Text="Accepts an asset tag such as P-204, or a full tag payload." />
                        <TextBox Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="P-204"
                                 MinHeight="{StaticResource ControlHeightMediumLarge}"
                                 AutomationProperties.Name="Asset code" />
                        <Button Style="{StaticResource OutlinedButtonStyle}"
                                HorizontalAlignment="Stretch"
                                MinHeight="{StaticResource ControlHeightMediumLarge}"
                                Command="{Binding Lookup}"
                                Content="Open asset"
                                AutomationProperties.Name="Open asset" />
                    </StackPanel>
                </Border>

                <!-- The records could not be read: not the same as no asset matching the code. -->
                <TextBlock Text="{Binding ReadError}"
                           Style="{StaticResource ErrorText}"
                           AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding ReadError, Converter={StaticResource StringToVisibility}}" />

                <Border Style="{StaticResource TileSurface}"
                        Visibility="{Binding NotResolved, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space100}">
                        <controls:StatusChip Severity="Critical" Text="Asset unavailable" />
                        <TextBlock Text="{Binding ResultMessage}" Style="{StaticResource SupportingText}" />
                        <TextBlock Style="{StaticResource SupportingText}"
                                   Text="Check the code against the nameplate, or browse Assets for what this device is holding." />
                    </StackPanel>
                </Border>
            </StackPanel>
    </utu:SafeArea>
</Page>

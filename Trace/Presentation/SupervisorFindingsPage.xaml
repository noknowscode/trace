<Page x:Class="Trace.Presentation.SupervisorFindingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Trace.Presentation.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

    <utu:SafeArea Insets="VisibleBounds" IsTabStop="False">
        <!--
            Narrow, Normal and Wide stack the two lists in one column (16 px sides on a phone, 24
            from Normal). Widest is the supervisor's desk: corrective work and the assets behind
            it sit side by side, in a wider column that stops at ReviewMaxWidth and centres.
        -->
        <Grid RowSpacing="{StaticResource SpaceL}"
              Padding="{utu:Responsive Narrow={StaticResource PagePadding}, Normal={StaticResource PagePaddingWide}}"
              MaxWidth="{utu:Responsive Narrow={StaticResource ContentMaxWidth}, Widest={StaticResource ReviewMaxWidth}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <controls:PageHeader Eyebrow="REVIEW"
                                     Title="Findings"
                                     Supporting="{Binding Headline}" />
                <!-- A Dispatch or Close the device could not write. -->
                <TextBlock Text="{Binding DispatchError}"
                           Style="{StaticResource ErrorText}"
                           Margin="{StaticResource GapTopS}"
                           AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding DispatchError, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <Grid RowSpacing="{utu:Responsive Narrow={StaticResource SpaceXL}, Widest=0}"
                      ColumnSpacing="{utu:Responsive Narrow=0, Widest={StaticResource SpaceXL}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="{StaticResource SpaceM}"
                                Grid.ColumnSpan="{utu:Responsive Narrow=2, Widest=1}">
                        <TextBlock Text="Corrective work" Style="{StaticResource SectionHeaderText}" />

                        <mvux:FeedView IsTabStop="False" Source="{Binding Actions}"
                                       ProgressTemplate="{StaticResource FeedProgressTemplate}"
                                       ErrorTemplate="{StaticResource FeedErrorTemplate}">
                            <mvux:FeedView.ValueTemplate>
                                <DataTemplate>
                                    <ItemsRepeater ItemsSource="{Binding Data}" TabFocusNavigation="Local">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="{StaticResource SpaceM}" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CardSurface}">
                                                    <Grid ColumnSpacing="{StaticResource SpaceM}" RowSpacing="{StaticResource SpaceS}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Origin, what to do, and the supervisor's next step with it:
                                                             Dispatch an open action, Close a dispatched one. -->
                                                        <StackPanel Spacing="{StaticResource SpaceXS}">
                                                            <TextBlock Text="{Binding Origin}"
                                                                       Style="{StaticResource EyebrowText}" />
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Style="{StaticResource CardTitleText}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <controls:StatusChip Grid.Column="1"
                                                                             VerticalAlignment="Top"
                                                                             Severity="{Binding Priority, Converter={StaticResource ToSeverity}}"
                                                                             Text="{Binding Priority}" />

                                                        <controls:WrapPanel Grid.Row="1"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalSpacing="{StaticResource SpaceS}"
                                                                            VerticalSpacing="{StaticResource SpaceS}">
                                                            <controls:StatusChip
                                                                Severity="{Binding Status, Converter={StaticResource ToSeverity}}"
                                                                Text="{Binding Status}" />
                                                            <Border Style="{StaticResource ValueChip}">
                                                                <TextBlock Style="{StaticResource ChipValueText}"
                                                                           Text="{Binding Assignee}" />
                                                            </Border>
                                                            <Border Style="{StaticResource ValueChip}">
                                                                <TextBlock Style="{StaticResource ChipValueText}"
                                                                           Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}}" />
                                                            </Border>
                                                        </controls:WrapPanel>

                                                        <Button Grid.Row="1" Grid.Column="1"
                                                                Style="{StaticResource OutlinedButtonStyle}"
                                                                VerticalAlignment="Bottom"
                                                                MinHeight="{StaticResource TouchTargetSize}"
                                                                Content="{Binding Converter={StaticResource NextStep}}"
                                                                Command="{utu:AncestorBinding AncestorType=mvux:FeedView, Path=DataContext.Advance}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanAdvance, Converter={StaticResource BoolToVisibility}}"
                                                                AutomationProperties.Name="{Binding Converter={StaticResource NextStep}, ConverterParameter=Name}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </DataTemplate>
                            </mvux:FeedView.ValueTemplate>

                            <mvux:FeedView.NoneTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardSurface}">
                                        <StackPanel Spacing="{StaticResource SpaceS}">
                                            <TextBlock Text="No corrective work raised"
                                                       Style="{StaticResource SectionHeaderText}" />
                                            <TextBlock Style="{StaticResource SupportingText}"
                                                       Text="Actions created from a failed inspection point appear here for dispatch." />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </mvux:FeedView.NoneTemplate>
                        </mvux:FeedView>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpaceM}"
                                Grid.Row="{utu:Responsive Narrow=1, Widest=0}"
                                Grid.Column="{utu:Responsive Narrow=0, Widest=1}"
                                Grid.ColumnSpan="{utu:Responsive Narrow=2, Widest=1}">
                        <TextBlock Text="Assets needing attention" Style="{StaticResource SectionHeaderText}" />

                        <mvux:FeedView IsTabStop="False" Source="{Binding AtRisk}"
                                       ProgressTemplate="{StaticResource FeedProgressTemplate}"
                                       ErrorTemplate="{StaticResource FeedErrorTemplate}">
                            <mvux:FeedView.ValueTemplate>
                                <DataTemplate>
                                    <ItemsRepeater ItemsSource="{Binding Data}" TabFocusNavigation="Local">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="{StaticResource SpaceM}" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CardButtonStyle}"
                                                        AutomationProperties.Name="{Binding Designation}"
                                                        uen:Navigation.Request="../Asset"
                                                        uen:Navigation.Data="{Binding}">
                                                    <controls:AssetCardContent />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </DataTemplate>
                            </mvux:FeedView.ValueTemplate>

                            <mvux:FeedView.NoneTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TileSurface}">
                                        <TextBlock Style="{StaticResource SupportingText}"
                                                   Text="Every asset on this device is passing." />
                                    </Border>
                                </DataTemplate>
                            </mvux:FeedView.NoneTemplate>
                        </mvux:FeedView>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </utu:SafeArea>
</Page>

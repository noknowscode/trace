<Page x:Class="Trace.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Trace.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

    <!--
        One content region, two navigation controls. The bottom bar and the vertical rail
        carry the same Region.Name values and only one is visible at a time, so switching
        form factor never loses the current destination.

        The Asset region has no tab of its own: it is reached by choosing an asset, which is
        the whole premise of the app — the machine is the destination, not a menu entry.
    -->
    <Grid uen:Region.Attached="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FormFactorStates">
                <VisualState x:Name="Handheld">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RailHost.Visibility" Value="Collapsed" />
                        <Setter Target="BottomNavigation.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Workstation">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RailHost.Visibility" Value="Visible" />
                        <Setter Target="BottomNavigation.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            Wide form factors: a persistent left rail. The bar is hosted inside a
            fixed-height host because the vertical style divides whatever height it is given
            equally between its items: unbounded it collapses, stretched it spreads five
            destinations across the whole window. 360 gives each of the five a 72 high slot.
        -->
        <Border x:Name="RailHost"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Visibility="Collapsed"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="0,0,1,0">
        <utu:TabBar x:Name="NavigationRail"
                    VerticalAlignment="Top"
                    Margin="0,12,0,0"
                    Height="360"
                    Style="{StaticResource MaterialVerticalTabBarStyle}"
                    uen:Region.Attached="True">
            <utu:TabBarItem uen:Region.Name="Today"
                            Content="Today"
                            AutomationProperties.Name="Today"
                            Style="{StaticResource MaterialVerticalTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconToday}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem uen:Region.Name="Assets"
                            Content="Assets"
                            AutomationProperties.Name="Assets"
                            Style="{StaticResource MaterialVerticalTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconAssets}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem uen:Region.Name="Scan"
                            Content="Scan"
                            AutomationProperties.Name="Scan"
                            Style="{StaticResource MaterialVerticalTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconScan}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem uen:Region.Name="Sync"
                            Content="Sync"
                            AutomationProperties.Name="Sync"
                            BadgeValue="{Binding PendingCount}"
                            BadgeVisibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource MaterialVerticalTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconSync}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem uen:Region.Name="Findings"
                            Content="Findings"
                            AutomationProperties.Name="Findings"
                            Style="{StaticResource MaterialVerticalTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconFindings}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
        </utu:TabBar>
        </Border>

        <!-- Destinations. All start collapsed; the Visibility navigator reveals one. -->
        <Grid Grid.Row="0"
              Grid.Column="1"
              uen:Region.Attached="True"
              uen:Region.Navigator="Visibility">
            <Grid uen:Region.Name="Today" Visibility="Collapsed">
                <local:TodayPage />
            </Grid>
            <Grid uen:Region.Name="Assets" Visibility="Collapsed">
                <local:AssetsPage />
            </Grid>
            <Grid uen:Region.Name="Scan" Visibility="Collapsed">
                <local:ScanPage />
            </Grid>
            <Grid uen:Region.Name="Sync" Visibility="Collapsed">
                <local:SyncPage />
            </Grid>
            <Grid uen:Region.Name="Findings" Visibility="Collapsed">
                <local:SupervisorFindingsPage />
            </Grid>
            <Grid uen:Region.Name="Asset" Visibility="Collapsed">
                <local:AssetPage />
            </Grid>
        </Grid>

        <!-- Handheld: a bottom bar within thumb reach. -->
        <utu:TabBar x:Name="BottomNavigation"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource MaterialBottomTabBarStyle}"
                    utu:SafeArea.Insets="Bottom"
                    uen:Region.Attached="True">
            <utu:TabBarItem uen:Region.Name="Today"
                            Content="Today"
                            AutomationProperties.Name="Today"
                            Style="{StaticResource MaterialBottomTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconToday}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem uen:Region.Name="Assets"
                            Content="Assets"
                            AutomationProperties.Name="Assets"
                            Style="{StaticResource MaterialBottomTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconAssets}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem uen:Region.Name="Scan"
                            Content="Scan"
                            AutomationProperties.Name="Scan"
                            Style="{StaticResource MaterialBottomTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconScan}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem uen:Region.Name="Sync"
                            Content="Sync"
                            AutomationProperties.Name="Sync"
                            BadgeValue="{Binding PendingCount}"
                            BadgeVisibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource MaterialBottomTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconSync}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem uen:Region.Name="Findings"
                            Content="Findings"
                            AutomationProperties.Name="Findings"
                            Style="{StaticResource MaterialBottomTabBarItemStyle}">
                <utu:TabBarItem.Icon>
                    <PathIcon Data="{StaticResource IconFindings}" />
                </utu:TabBarItem.Icon>
            </utu:TabBarItem>
        </utu:TabBar>
    </Grid>
</Page>

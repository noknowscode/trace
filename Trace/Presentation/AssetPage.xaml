<Page x:Class="Trace.Presentation.AssetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Trace.Presentation.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

    <!--
        System bars come off as attached insets. The on-screen keyboard is handled by a SafeArea
        control with only SoftInput, which wraps the page in its own ScrollViewer so a focused
        reading field can be scrolled above the keyboard. A ScrollViewer measures its content at
        infinite height, though, which left the workspace's star row unbounded: the machine and
        the inspector ran off the bottom of the window. The page frame is therefore pinned to the
        keyboard area's height in code-behind, so the rows below divide the window, not infinity.

        Layout per width category (utu:Responsive, Toolkit default breakpoints):
        * Narrow (a phone, below 600): back on its own row and the four tabs full width beneath
          it, so "Documents" is never clipped; the inspector is a bottom sheet over the machine.
        * Normal (600-800): back and tabs share one row; the inspector is still a sheet.
        * Wide (800-1080): the inspector docks beside the machine at 360, the tablet's
          "canvas + pinned inspector".
        * Widest (1080 and up): docked at 400, and the workspace stops at WorkspaceMaxWidth and
          centres.
        The inspector is one element at every size. Moving the same element rather than swapping
        two copies keeps a half-entered reading alive across a resize; re-parenting would unload it.
    -->
    <Grid utu:SafeArea.Insets="VisibleBounds">
    <utu:SafeArea x:Name="KeyboardArea" Insets="SoftInput" IsTabStop="False" SizeChanged="OnKeyboardAreaResized">
    <Grid x:Name="PageFrame">
        <Grid x:Name="PageRoot"
              Padding="{utu:Responsive Narrow={StaticResource PagePadding}, Normal={StaticResource PagePaddingWide}}"
              MaxWidth="{StaticResource WorkspaceMaxWidth}"
              RowSpacing="{StaticResource SpaceM}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Back and the tabs share one row from Normal up, so the asset identity can move onto
                the equipment view, where it labels the machine instead of sitting in a band above
                it. Connection state stays here because it is true of every tab.
            -->
            <Grid ColumnSpacing="{StaticResource SpaceS}"
                  RowSpacing="{utu:Responsive Narrow={StaticResource SpaceXS}, Normal=0}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Center"
                        Command="{Binding Back}"
                        AutomationProperties.Name="Back to today"
                        ToolTipService.ToolTip="Back to today">
                    <Viewbox Width="{StaticResource IconSizeM}" Height="{StaticResource IconSizeM}">
                        <PathIcon Data="{StaticResource IconBack}" />
                    </Viewbox>
                </Button>

                <utu:TabBar Grid.Row="{utu:Responsive Narrow=1, Normal=0}"
                            Grid.Column="{utu:Responsive Narrow=0, Normal=1}"
                            Grid.ColumnSpan="{utu:Responsive Narrow=3, Normal=1}"
                            MaxWidth="{StaticResource AssetTabsMaxWidth}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialTopTabBarStyle}"
                            IsTabStop="False"
                            SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
                    <utu:TabBarItem Content="Overview" AutomationProperties.Name="Overview" Style="{StaticResource MaterialTopTabBarItemStyle}" />
                    <utu:TabBarItem Content="Inspect" AutomationProperties.Name="Inspect" Style="{StaticResource MaterialTopTabBarItemStyle}" />
                    <utu:TabBarItem Content="History" AutomationProperties.Name="History" Style="{StaticResource MaterialTopTabBarItemStyle}" />
                    <utu:TabBarItem Content="Documents" AutomationProperties.Name="Documents" Style="{StaticResource MaterialTopTabBarItemStyle}" />
                </utu:TabBar>

                <controls:StatusChip Grid.Column="2"
                                     VerticalAlignment="Center"
                                     Severity="Caution"
                                     Text="Working offline"
                                     Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!--
                The tabs without an equipment view still have to say which machine they are
                about — recording against the wrong asset is the failure this app exists to
                prevent — so identity appears here whenever the canvas is not carrying it.
            -->
            <controls:PageHeader Grid.Row="1"
                                 Eyebrow="{Binding Designation}"
                                 Title="{Binding AssetName}"
                                 Supporting="{Binding Location}"
                                 Visibility="{Binding IsInspect, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <Grid x:Name="WorkspaceHost" Grid.Row="2" SizeChanged="OnWorkspaceResized">

                <!-- ============================ INSPECT ============================ -->
                <!-- The gap opens only when the inspector docks: a sheet spans both columns, and an
                     empty column must not shave the machine. -->
                <Grid Visibility="{Binding IsInspect, Converter={StaticResource BoolToVisibility}}"
                      ColumnSpacing="{utu:Responsive Narrow=0, Wide={StaticResource SpaceM}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="InspectorColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="SceneStack" RowSpacing="{StaticResource SpaceM}">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="SceneRow" Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The machine, with its points pinned to it. The scene takes all the
                             height it is given: the camera frames the model to whatever
                             aspect the workspace has. -->
                        <Border x:Name="SceneCard"
                                Style="{StaticResource CardSurface}"
                                Padding="{StaticResource TilePadding}"
                                MinHeight="{StaticResource SceneMinHeight}">
                            <Grid>
                                <controls:AssetSceneView x:Name="Scene"
                                                         Style="{StaticResource AssetSceneViewStyle}"
                                                         Kind="{Binding SchematicKind}"
                                                         ModelSource="{Binding ModelUri}" />
                                <!-- Each marker, and below each chip, is its own tab stop: ItemsRepeater otherwise
                                     takes Tab once, and the points after the first are out of a keyboard's reach. -->
                                <ItemsRepeater x:Name="MarkerLayer" ItemsSource="{Binding Markers}" TabFocusNavigation="Local">
                                    <ItemsRepeater.Layout>
                                        <controls:SpatialMarkerLayout x:Name="MarkerLayout" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <controls:InspectionPointMarker
                                                Style="{StaticResource InspectionPointMarkerStyle}"
                                                Sequence="{Binding Point.Sequence}"
                                                Disposition="{Binding Point.Disposition}"
                                                IsSelected="{Binding IsSelected}"
                                                controls:SpatialMarkers.AnchorId="{Binding Point.Id}"
                                                Command="{Binding DataContext.SelectMarker, ElementName=PageRoot}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Point.Label}"
                                                ToolTipService.ToolTip="{Binding Point.Label}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <!--
                                    The machine's nameplate, on the machine, across the top. The
                                    plate is the same brush the scene paints its background with,
                                    so it is invisible over empty canvas and only resolves into a
                                    plate where the model would otherwise sit behind the text. It
                                    takes no pointer input: a drag that starts on it still turns
                                    the machine.
                                -->
                                <Border Style="{StaticResource ScenePlate}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                    <controls:PageHeader Eyebrow="{Binding Designation}"
                                                         Title="{Binding AssetName}"
                                                         Supporting="{Binding Location}" />
                                </Border>

                                <!-- How to turn the machine and how to put it back, together along the bottom. -->
                                <Grid VerticalAlignment="Bottom" ColumnSpacing="{StaticResource SpaceS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ScenePlate}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="{StaticResource ChipPadding}">
                                        <TextBlock Style="{StaticResource SupportingText}"
                                                   Text="Drag to turn the machine" />
                                    </Border>
                                    <!-- On a plate of its own, like the hint: over the machine the bare label was hard to read. -->
                                    <Border Grid.Column="1"
                                            Background="{ThemeResource SurfaceBrush}"
                                            CornerRadius="{StaticResource ControlRadius}">
                                        <Button Style="{StaticResource TextButtonStyle}"
                                                MinHeight="{StaticResource TouchTargetSize}"
                                                Click="OnResetView"
                                                Content="Reset view"
                                                AutomationProperties.Name="Reset view" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Every point also reachable as a list: a marker on a machine is
                             not a usable target for a screen reader or a keyboard. -->
                        <StackPanel x:Name="PointListPanel"
                                    Grid.Row="1"
                                    Spacing="{StaticResource SpaceS}"
                                    SizeChanged="OnWorkspaceResized">
                            <TextBlock Text="Inspection points" Style="{StaticResource FieldLabelText}" />
                            <!-- A strip rather than a wrap: on a phone four points do not
                                 fit across, and a scrolling strip keeps the machine above it
                                 at full size instead of losing rows to a second line. -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Auto"
                                          VerticalScrollMode="Disabled">
                                <ItemsRepeater ItemsSource="{Binding Markers}" TabFocusNavigation="Local">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="{StaticResource SpaceS}" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CardButtonStyle}"
                                                    Padding="{StaticResource CompactCardPadding}"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.SelectMarker, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Point.Label}">
                                                <StackPanel Spacing="{StaticResource SpaceXS}">
                                                    <TextBlock Text="{Binding Point.Label}"
                                                               Style="{StaticResource CardTitleText}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                                        <TextBlock Style="{StaticResource SupportingText}">
                                                            <Run Text="{Binding Point.LatestReadingText}" />
                                                            <Run Text="{Binding Point.Unit}" />
                                                        </TextBlock>
                                                        <controls:StatusChip
                                                            Severity="{Binding Point.Disposition, Converter={StaticResource ToSeverity}}"
                                                            Text="{Binding Point.Disposition}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>

                    <!-- The inspector: a bottom sheet below Wide, a docked pane from Wide up. Its height
                         cap comes from the measured workspace (code-behind). -->
                    <Border x:Name="InspectorHost"
                            Style="{StaticResource SheetSurface}"
                            Grid.Column="{utu:Responsive Narrow=0, Wide=1}"
                            Grid.ColumnSpan="{utu:Responsive Narrow=2, Wide=1}"
                            VerticalAlignment="{utu:Responsive Narrow=Bottom, Wide=Stretch}"
                            Width="{utu:Responsive Narrow=NaN, Wide={StaticResource InspectorWidthWide}, Widest={StaticResource InspectorWidthWidest}}"
                            CornerRadius="{utu:Responsive Narrow={StaticResource SheetRadius}, Wide={StaticResource CardRadius}}"
                            Padding="{utu:Responsive Narrow={StaticResource SheetPadding}, Normal={StaticResource SheetPaddingWide}}"
                            Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
                        <controls:PointInspector />
                    </Border>
                </Grid>

                <!-- ============================ OVERVIEW ============================ -->
                <!--
                    Overview, History and Documents read as one column under the header: the full
                    workspace width until it reaches ContentMaxWidth, then no wider, still aligned
                    with the header on the left.
                -->
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentMaxWidth}" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource SpaceM}">
                        <mvux:FeedView IsTabStop="False" Source="{Binding Asset}"
                                       ProgressTemplate="{StaticResource FeedProgressTemplate}"
                                       ErrorTemplate="{StaticResource FeedErrorTemplate}">
                            <mvux:FeedView.ValueTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardSurface}">
                                        <StackPanel Spacing="{StaticResource SpaceM}">
                                            <TextBlock Text="Condition" Style="{StaticResource SectionHeaderText}" />
                                            <controls:WrapPanel HorizontalSpacing="{StaticResource SpaceS}" VerticalSpacing="{StaticResource SpaceS}">
                                                <controls:StatusChip
                                                    Severity="{Binding Data.Condition, Converter={StaticResource ToSeverity}}"
                                                    Text="{Binding Data.Condition}" />
                                                <Border Style="{StaticResource ValueChip}">
                                                    <TextBlock Style="{StaticResource ChipValueText}">
                                                        <Run Text="{Binding Data.InspectedPointCount}" />
                                                        <Run Text="of" />
                                                        <Run Text="{Binding Data.PointCount}" />
                                                        <Run Text="points inspected" />
                                                    </TextBlock>
                                                </Border>
                                            </controls:WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </mvux:FeedView.ValueTemplate>
                            <mvux:FeedView.NoneTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardSurface}">
                                        <StackPanel Spacing="{StaticResource SpaceS}">
                                            <controls:StatusChip Severity="Critical" Text="Asset unavailable" />
                                            <TextBlock Style="{StaticResource SupportingText}"
                                                       Text="This asset is no longer on the device. It may have been reassigned since your last sync." />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </mvux:FeedView.NoneTemplate>
                        </mvux:FeedView>

                        <TextBlock Text="Open findings" Style="{StaticResource SectionHeaderText}" />
                        <mvux:FeedView IsTabStop="False" Source="{Binding Findings}"
                                       ProgressTemplate="{StaticResource FeedProgressTemplate}"
                                       ErrorTemplate="{StaticResource FeedErrorTemplate}">
                            <mvux:FeedView.ValueTemplate>
                                <DataTemplate>
                                    <ItemsRepeater ItemsSource="{Binding Data}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="{StaticResource SpaceS}" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TileSurface}">
                                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                                        <TextBlock Text="{Binding PointLabel}"
                                                                   Style="{StaticResource EyebrowText}" />
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Style="{StaticResource BodyText}"
                                                                   TextWrapping="Wrap" />
                                                        <controls:WrapPanel HorizontalSpacing="{StaticResource SpaceS}" VerticalSpacing="{StaticResource SpaceS}">
                                                            <controls:StatusChip
                                                                Severity="{Binding Priority, Converter={StaticResource ToSeverity}}"
                                                                Text="{Binding Priority}" />
                                                            <controls:StatusChip Severity="Neutral"
                                                                                 Text="{Binding Assignee}" />
                                                        </controls:WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </DataTemplate>
                            </mvux:FeedView.ValueTemplate>
                            <mvux:FeedView.NoneTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TileSurface}">
                                        <TextBlock Style="{StaticResource SupportingText}"
                                                   Text="No corrective work is open on this asset." />
                                    </Border>
                                </DataTemplate>
                            </mvux:FeedView.NoneTemplate>
                        </mvux:FeedView>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================ HISTORY ============================ -->
                <mvux:FeedView IsTabStop="False" Source="{Binding History}"
                               ProgressTemplate="{StaticResource FeedProgressTemplate}"
                               ErrorTemplate="{StaticResource FeedErrorTemplate}"
                               Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}">
                    <mvux:FeedView.ValueTemplate>
                        <DataTemplate>
                            <ScrollViewer>
                                <ItemsRepeater ItemsSource="{Binding Data}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="{StaticResource SpaceS}" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardSurface}" Padding="{StaticResource TilePadding}">
                                                <Grid ColumnSpacing="{StaticResource SpaceM}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Style="{StaticResource TimelineSpine}" />

                                                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceXS}">
                                                        <TextBlock Text="{Binding PointLabel}"
                                                                   Style="{StaticResource EyebrowText}" />
                                                        <TextBlock Text="{Binding ReadingText}"
                                                                   Style="{StaticResource CardTitleText}" />
                                                        <TextBlock Text="{Binding Notes}"
                                                                   Style="{StaticResource SupportingText}"
                                                                   Visibility="{Binding Notes, Converter={StaticResource StringToVisibility}}" />
                                                        <controls:WrapPanel HorizontalSpacing="{StaticResource SpaceS}" VerticalSpacing="{StaticResource SpaceS}">
                                                            <controls:StatusChip
                                                                Severity="{Binding Disposition, Converter={StaticResource ToSeverity}}"
                                                                Text="{Binding Disposition}" />
                                                            <controls:StatusChip
                                                                Severity="{Binding SyncState, Converter={StaticResource ToSeverity}}"
                                                                Text="{Binding SyncState}" />
                                                            <Border Style="{StaticResource ValueChip}">
                                                                <TextBlock Style="{StaticResource ChipValueText}"
                                                                           Text="{Binding Technician}" />
                                                            </Border>
                                                        </controls:WrapPanel>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Top"
                                                               Style="{StaticResource SupportingText}"
                                                               Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </DataTemplate>
                    </mvux:FeedView.ValueTemplate>
                    <mvux:FeedView.NoneTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardSurface}" VerticalAlignment="Top">
                                <StackPanel Spacing="{StaticResource SpaceS}">
                                    <TextBlock Text="No inspections recorded"
                                               Style="{StaticResource SectionHeaderText}" />
                                    <TextBlock Style="{StaticResource SupportingText}"
                                               Text="Completed points appear here, newest first, with the reading and who recorded it." />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </mvux:FeedView.NoneTemplate>
                </mvux:FeedView>

                <!-- ============================ DOCUMENTS ============================ -->
                <ScrollViewer Visibility="{Binding IsDocuments, Converter={StaticResource BoolToVisibility}}">
                    <mvux:FeedView IsTabStop="False" Source="{Binding Asset}"
                                   ProgressTemplate="{StaticResource FeedProgressTemplate}"
                                   ErrorTemplate="{StaticResource FeedErrorTemplate}">
                        <mvux:FeedView.ValueTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="{StaticResource SpaceM}">
                                    <Border Style="{StaticResource CardSurface}">
                                        <StackPanel Spacing="{StaticResource SpaceM}">
                                            <TextBlock Text="Nameplate" Style="{StaticResource SectionHeaderText}" />
                                            <Grid ColumnSpacing="{StaticResource SpaceL}" RowSpacing="{StaticResource SpaceS}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Data.Manufacturer}"
                                                           Style="{StaticResource BodyText}" />

                                                <TextBlock Grid.Row="1" Text="Model" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Data.Model}"
                                                           Style="{StaticResource BodyText}" />

                                                <TextBlock Grid.Row="2" Text="Serial" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Data.SerialNumber}"
                                                           Style="{StaticResource BodyText}" />

                                                <TextBlock Grid.Row="3" Text="Installed" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1"
                                                           Text="{Binding Data.InstalledOn, Converter={StaticResource RelativeTime}}"
                                                           Style="{StaticResource BodyText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource TileSurface}">
                                        <StackPanel Spacing="{StaticResource SpaceS}">
                                            <TextBlock Text="No documents on this device"
                                                       Style="{StaticResource SectionHeaderText}" />
                                            <TextBlock Style="{StaticResource SupportingText}"
                                                       Text="Manuals and drawings sync with the asset record. Nothing has been downloaded for offline use yet." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </mvux:FeedView.ValueTemplate>
                        <mvux:FeedView.NoneTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardSurface}">
                                    <StackPanel Spacing="{StaticResource SpaceS}">
                                        <controls:StatusChip Severity="Critical" Text="Asset unavailable" />
                                        <TextBlock Style="{StaticResource SupportingText}"
                                                   Text="This asset is no longer on the device, so its nameplate and documents are not either." />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </mvux:FeedView.NoneTemplate>
                    </mvux:FeedView>
                </ScrollViewer>
                </Grid>
            </Grid>

        </Grid>

        <!--
            Corrective action, raised from the point that failed. A modal sheet over the whole
            page: centred at DialogMaxWidth from Normal up, the full width less a margin on a phone.
        -->
        <Grid Background="{ThemeResource SheetScrimBrush}"
              Visibility="{Binding IsActionSheetOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource SheetSurface}"
                    MaxWidth="{StaticResource DialogMaxWidth}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="{StaticResource InsetL}"
                    Padding="{utu:Responsive Narrow={StaticResource SheetPadding}, Normal={StaticResource SheetPaddingWide}}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource SpaceM}">
                            <StackPanel Spacing="{StaticResource SpaceXXS}">
                                <TextBlock Text="CORRECTIVE ACTION" Style="{StaticResource EyebrowText}" />
                                <TextBlock Style="{StaticResource PanelTitleText}"
                                           TextWrapping="Wrap">
                                    <Run Text="Raise work from" />
                                    <Run Text="{Binding SelectedPoint.Label}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SupportingText}"
                                           Text="The asset, the point and the inspection that failed are carried across automatically." />
                            </StackPanel>

                            <StackPanel Spacing="{StaticResource SpaceS}">
                                <TextBlock Text="Summary" Style="{StaticResource FieldLabelText}" />
                                <TextBox Text="{Binding ActionSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="{StaticResource TouchTargetSize}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="Corrective action summary" />
                            </StackPanel>

                            <!-- Side by side from Normal; stacked on a phone, where two pickers
                                 across 300 px cut "Mechanical Team" short. -->
                            <Grid ColumnSpacing="{utu:Responsive Narrow=0, Normal={StaticResource SpaceM}}"
                                  RowSpacing="{utu:Responsive Narrow={StaticResource SpaceM}, Normal=0}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceS}"
                                            Grid.ColumnSpan="{utu:Responsive Narrow=2, Normal=1}">
                                    <TextBlock Text="Priority" Style="{StaticResource FieldLabelText}" />
                                    <ComboBox ItemsSource="{Binding Priorities}"
                                              SelectedItem="{Binding ActionPriority, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource TouchTargetSize}"
                                              AutomationProperties.Name="Priority" />
                                </StackPanel>
                                <StackPanel Grid.Row="{utu:Responsive Narrow=1, Normal=0}"
                                            Grid.Column="{utu:Responsive Narrow=0, Normal=1}"
                                            Grid.ColumnSpan="{utu:Responsive Narrow=2, Normal=1}"
                                            Spacing="{StaticResource SpaceS}">
                                    <TextBlock Text="Assignee" Style="{StaticResource FieldLabelText}" />
                                    <ComboBox ItemsSource="{Binding Assignees}"
                                              SelectedItem="{Binding ActionAssignee, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource TouchTargetSize}"
                                              AutomationProperties.Name="Assignee" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding ActionError}"
                                       Style="{StaticResource ErrorText}"
                                       Visibility="{Binding ActionError, Converter={StaticResource StringToVisibility}}" />

                            <Grid ColumnSpacing="{StaticResource SpaceS}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource OutlinedButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="{StaticResource TouchTargetSize}"
                                        Command="{Binding CancelAction}"
                                        Content="Cancel" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource FilledButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="{StaticResource TouchTargetSize}"
                                        Command="{Binding CreateAction}"
                                        IsEnabled="{Binding CanCreateAction}"
                                        Content="Create action" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
    </utu:SafeArea>
    </Grid>
</Page>

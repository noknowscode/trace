<Page x:Class="Trace.Presentation.SyncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Trace.Presentation.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

    <utu:SafeArea Insets="VisibleBounds" IsTabStop="False">
        <!-- One column, as on Today: 16 px sides on a phone, 24 from Normal, centred at ContentMaxWidth from Widest. -->
        <Grid RowSpacing="{StaticResource SpaceL}"
              Padding="{utu:Responsive Narrow={StaticResource PagePadding}, Normal={StaticResource PagePaddingWide}}"
              MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PageHeader Eyebrow="OFFLINE QUEUE"
                                 Title="Sync"
                                 Supporting="{Binding PendingLabel}" />

            <Border Grid.Row="1" Style="{StaticResource CardSurface}">
                <StackPanel Spacing="{StaticResource SpaceM}">
                    <controls:WrapPanel HorizontalSpacing="{StaticResource SpaceS}" VerticalSpacing="{StaticResource SpaceS}">
                        <controls:StatusChip Severity="Positive" Text="Online"
                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                        <controls:StatusChip Severity="Caution" Text="Offline"
                                             Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
                        <controls:StatusChip Severity="Positive" Text="All changes synchronized"
                                             Visibility="{Binding IsSettled, Converter={StaticResource BoolToVisibility}}" />
                    </controls:WrapPanel>

                    <TextBlock Style="{StaticResource SupportingText}"
                               Text="{Binding LastResult}"
                               Visibility="{Binding LastResult, Converter={StaticResource StringToVisibility}}" />

                    <!-- Records that could not be read at launch: the queue below may be missing work. -->
                    <Border Style="{StaticResource TileSurface}"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="{Binding HasSetAside, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="{StaticResource SpaceS}">
                            <controls:StatusChip Severity="Critical" Text="Records set aside" />
                            <TextBlock Style="{StaticResource SupportingText}"
                                       Text="{Binding SetAsideWarning}" />
                        </StackPanel>
                    </Border>

                    <!-- Wraps on a phone: three buttons do not fit across 328 px. -->
                    <controls:WrapPanel HorizontalSpacing="{StaticResource SpaceS}" VerticalSpacing="{StaticResource SpaceS}">
                        <Button Style="{StaticResource FilledButtonStyle}"
                                MinHeight="{StaticResource TouchTargetSize}"
                                Command="{Binding SyncNow}"
                                IsEnabled="{Binding IsOnline}"
                                Content="Sync now"
                                AutomationProperties.Name="Sync now" />
                        <Button Style="{StaticResource OutlinedButtonStyle}"
                                MinHeight="{StaticResource TouchTargetSize}"
                                Command="{Binding RetryFailed}"
                                Content="Retry failed uploads"
                                AutomationProperties.Name="Retry failed uploads"
                                Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource TextButtonStyle}"
                                MinHeight="{StaticResource TouchTargetSize}"
                                Command="{Binding ToggleConnection}"
                                Content="{Binding ConnectionAction}"
                                AutomationProperties.Name="{Binding ConnectionAction}" />
                    </controls:WrapPanel>

                    <TextBlock Style="{StaticResource SupportingText}"
                               Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"
                               Text="Sync is unavailable while offline. Keep inspecting — every reading is already saved on this device." />
                </StackPanel>
            </Border>

            <mvux:FeedView IsTabStop="False" Grid.Row="2"
                           Source="{Binding Operations}"
                           ProgressTemplate="{StaticResource FeedProgressTemplate}"
                           ErrorTemplate="{StaticResource FeedErrorTemplate}">
                <mvux:FeedView.ValueTemplate>
                    <DataTemplate>
                        <ScrollViewer>
                            <ItemsRepeater ItemsSource="{Binding Data}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="{StaticResource SpaceS}" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TileSurface}">
                                            <Grid ColumnSpacing="{StaticResource SpaceM}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="{StaticResource SpaceXS}">
                                                    <TextBlock Text="{Binding KindLabel}"
                                                               Style="{StaticResource EyebrowText}" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource BodyText}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Error}"
                                                               Style="{StaticResource ErrorText}"
                                                               Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />
                                                </StackPanel>
                                                <controls:StatusChip Grid.Column="1"
                                                                     VerticalAlignment="Top"
                                                                     Severity="{Binding Status, Converter={StaticResource ToSeverity}}"
                                                                     Text="{Binding Status}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </DataTemplate>
                </mvux:FeedView.ValueTemplate>

                <mvux:FeedView.NoneTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardSurface}" VerticalAlignment="Top">
                            <StackPanel Spacing="{StaticResource SpaceS}">
                                <TextBlock Text="Nothing waiting to sync" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Style="{StaticResource SupportingText}"
                                           Text="Completed inspections and corrective actions appear here until the server confirms them." />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </mvux:FeedView.NoneTemplate>
            </mvux:FeedView>
        </Grid>
    </utu:SafeArea>
</Page>

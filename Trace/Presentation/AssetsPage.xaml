<Page x:Class="Trace.Presentation.AssetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Trace.Presentation.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

    <!--
        No SoftInput inset: the search field sits at the top, above any on-screen keyboard, and
        the list under it scrolls on its own. (With SoftInput the SafeArea control wraps the page
        in a ScrollViewer that measures it at infinite height, which left the list's star row
        unbounded and scrolled the search field away with the results.)
    -->
    <Grid utu:SafeArea.Insets="VisibleBounds">
        <!-- One column at every width, as on Today: 16 px sides on a phone, 24 from Normal, centred at ContentMaxWidth from Widest. -->
        <Grid RowSpacing="{StaticResource SpaceL}"
              Padding="{utu:Responsive Narrow={StaticResource PagePadding}, Normal={StaticResource PagePaddingWide}}"
              MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PageHeader Eyebrow="EQUIPMENT"
                                 Title="Assets"
                                 Supporting="Everything held on this device, scheduled or not." />

            <TextBox Grid.Row="1"
                     Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search by tag, name, area or site"
                     MinHeight="{StaticResource TouchTargetSize}"
                     AutomationProperties.Name="Search assets" />

            <mvux:FeedView IsTabStop="False" Grid.Row="2"
                           Source="{Binding Assets}"
                           ProgressTemplate="{StaticResource FeedProgressTemplate}"
                           ErrorTemplate="{StaticResource FeedErrorTemplate}">
                <mvux:FeedView.ValueTemplate>
                    <DataTemplate>
                        <ScrollViewer>
                            <ItemsRepeater ItemsSource="{Binding Data}" TabFocusNavigation="Local">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="{StaticResource SpaceM}" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButtonStyle}"
                                                AutomationProperties.Name="{Binding Designation}"
                                                uen:Navigation.Request="../Asset"
                                                uen:Navigation.Data="{Binding}">
                                            <controls:AssetCardContent />
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </DataTemplate>
                </mvux:FeedView.ValueTemplate>

                <mvux:FeedView.NoneTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardSurface}" VerticalAlignment="Top">
                            <StackPanel Spacing="{StaticResource SpaceS}">
                                <TextBlock Text="No matching assets" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Style="{StaticResource SupportingText}"
                                           Text="Clear the search, or scan the tag on the machine in front of you." />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </mvux:FeedView.NoneTemplate>
            </mvux:FeedView>
        </Grid>
    </Grid>
</Page>

<UserControl x:Class="Trace.Presentation.Controls.AssetCardContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Trace.Presentation.Controls"
             IsTabStop="False">

    <!--
        A row of the round. The asset carries its own condition, progress and findings, so
        there is no separate dashboard tile telling the technician what the machine already
        says. Bound against an AssetSummary inherited from the item container.
    -->
    <!-- A StackPanel rather than a three-row Grid: a Grid keeps the gap around an empty Reason
         row, which left assets off today's round with a double gap. -->
    <StackPanel Spacing="{StaticResource Space150}">

        <Grid ColumnSpacing="{StaticResource Space150}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="{StaticResource Space025}">
                <TextBlock Text="{Binding Designation}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{Binding AssetName}"
                           Style="{StaticResource CardTitleText}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Location}" Style="{StaticResource SupportingText}" />
            </StackPanel>

            <controls:StatusChip Grid.Column="1"
                                 Severity="{Binding Condition, Converter={StaticResource ToSeverity}}"
                                 Text="{Binding Converter={StaticResource AssetCardText}, ConverterParameter=Condition}"
                                 VerticalAlignment="Top" />
        </Grid>

        <TextBlock Text="{Binding Reason}"
                   Style="{StaticResource SupportingText}"
                   Visibility="{Binding Reason, Converter={StaticResource StringToVisibility}}" />

        <controls:WrapPanel HorizontalSpacing="{StaticResource Space100}" VerticalSpacing="{StaticResource Space100}">
            <Border Style="{StaticResource ValueChip}">
                <TextBlock Text="{Binding Converter={StaticResource AssetCardText}, ConverterParameter=Progress}" Style="{StaticResource ChipValueText}" />
            </Border>
            <Border Style="{StaticResource ValueChip}"
                    Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Converter={StaticResource AssetCardText}, ConverterParameter=Due}" Style="{StaticResource ChipValueText}" />
            </Border>
            <controls:StatusChip Severity="Critical"
                                 Text="{Binding Converter={StaticResource AssetCardText}, ConverterParameter=Findings}"
                                 Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
        </controls:WrapPanel>
    </StackPanel>
</UserControl>

<UserControl x:Class="Trace.Presentation.Controls.AssetDocumentsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Trace.Presentation.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             IsTabStop="False">

    <!--
        The asset's Documents tab, bound to the workspace (AssetModel): the nameplate and the
        inspection plan the device holds for it (D-003). One column at every width; the page caps
        it at ContentMaxWidth.
    -->
    <ScrollViewer>
        <mvux:FeedView IsTabStop="False" Source="{Binding Asset}"
                       ProgressTemplate="{StaticResource FeedProgressTemplate}"
                       ErrorTemplate="{StaticResource FeedErrorTemplate}">
            <mvux:FeedView.ValueTemplate>
                <DataTemplate>
                    <StackPanel Spacing="{StaticResource SpaceM}">
                        <Border Style="{StaticResource CardSurface}">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <TextBlock Text="Nameplate" Style="{StaticResource SectionHeaderText}" />
                                <Grid ColumnSpacing="{StaticResource SpaceL}" RowSpacing="{StaticResource SpaceS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Data.Manufacturer}"
                                               Style="{StaticResource BodyText}" />

                                    <TextBlock Grid.Row="1" Text="Model" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Data.Model}"
                                               Style="{StaticResource BodyText}" />

                                    <TextBlock Grid.Row="2" Text="Serial" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Data.SerialNumber}"
                                               Style="{StaticResource BodyText}" />

                                    <TextBlock Grid.Row="3" Text="Installed" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding Data.InstalledOn, Converter={StaticResource RelativeTime}}"
                                               Style="{StaticResource BodyText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- The inspection plan the device holds for this asset: each point,
                             what is read there, the band it is judged against and how. -->
                        <Border Style="{StaticResource CardSurface}">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <TextBlock Text="Inspection plan" Style="{StaticResource SectionHeaderText}" />
                                <ItemsRepeater ItemsSource="{Binding Data.Points}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="{StaticResource SpaceM}" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="{StaticResource SpaceXXS}">
                                                <TextBlock Style="{StaticResource CardTitleText}">
                                                    <Run Text="{Binding Sequence}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding Label}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource FieldLabelText}">
                                                    <Run Text="{Binding ReadingType}" />
                                                    <Run Text="· expected" />
                                                    <Run Text="{Binding ExpectedRange}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Guidance}" Style="{StaticResource SupportingText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardSurface}">
                        <StackPanel Spacing="{StaticResource SpaceS}">
                            <controls:StatusChip Severity="Critical" Text="Asset unavailable" />
                            <TextBlock Style="{StaticResource SupportingText}"
                                       Text="This asset is no longer on the device, so its nameplate and inspection plan are not either." />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </mvux:FeedView.NoneTemplate>
        </mvux:FeedView>
    </ScrollViewer>
</UserControl>

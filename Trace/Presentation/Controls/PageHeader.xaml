<UserControl x:Class="Trace.Presentation.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             IsTabStop="False">

    <Grid ColumnSpacing="{StaticResource Space200}" Padding="{StaticResource Space050BottomThickness}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="{StaticResource Space025}" VerticalAlignment="Center">
            <TextBlock Text="{Binding Eyebrow, ElementName=Root}"
                       Style="{StaticResource EyebrowText}"
                       Visibility="{Binding HasEyebrow, ElementName=Root}" />
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource PageTitleText}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Supporting, ElementName=Root}"
                       Style="{StaticResource SupportingText}"
                       Visibility="{Binding HasSupporting, ElementName=Root}"
                       Margin="{StaticResource Space025TopThickness}" />
        </StackPanel>

        <ContentPresenter Grid.Column="1"
                          Content="{Binding Actions, ElementName=Root}"
                          VerticalAlignment="Top" />
    </Grid>
</UserControl>

<UserControl x:Class="Trace.Presentation.Controls.PointInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Trace.Presentation.Controls"
             IsTabStop="False"
             SizeChanged="OnPartResized">

    <!--
        Everything one inspection point needs, bound to the workspace's PointInspectorModel, and
        nothing else; the photos and the camera bind to its evidence part (Evidence), whose own
        ViewEvidence opens a recorded photo. Hosted
        as a bottom sheet on a phone and as a pinned inspector on wider screens — the same element
        either way, so an in-progress reading survives a resize.

        The split between what scrolls and what stays is the design of this panel. A
        technician needs the reading they are entering, the call they are making and the
        button that commits it on screen together, with a glove on and one-handed, so those
        are pinned. The guidance, the previous reading, the notes and the evidence are
        reference and capture material, and they scroll.

        When the height cannot hold the pinned parts (a phone in landscape: 800x360, 844x390),
        the whole panel scrolls as one instead, so the validation message and Complete point
        stay reachable. The code-behind picks the state from the measured header and footer;
        the setters are here.
    -->
    <ScrollViewer x:Name="WholePanel"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="HeightStates">
            <VisualState x:Name="Pinned" />
            <VisualState x:Name="ScrollsAsOne">
                <VisualState.Setters>
                    <!-- Scroll bar visibility alone switches the scrolling: Disabled holds the
                         content to the viewport, Auto lets it run on. The middle has nothing of
                         its own to scroll in this state. -->
                    <Setter Target="WholePanel.VerticalScrollBarVisibility" Value="Auto" />
                    <Setter Target="WholePanel.Padding" Value="{StaticResource ScrollBarGutter}" />
                    <Setter Target="Body.VerticalScrollBarVisibility" Value="Disabled" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid RowSpacing="{StaticResource SpaceM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Identity, and the one action that throws entered work away, which confirms first.
             The messages under it are often hidden, so each carries its own gap rather than
             the panel's Spacing, which a collapsed child would still be charged. -->
        <StackPanel x:Name="Header" SizeChanged="OnPartResized">
            <Grid ColumnSpacing="{StaticResource SpaceS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource SpaceXXS}">
                    <TextBlock Text="INSPECTION POINT" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{Binding SelectedPoint.Label}"
                               Style="{StaticResource PanelTitleText}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource TextButtonStyle}"
                        VerticalAlignment="Top"
                        MinHeight="{StaticResource TouchTargetSize}"
                        Command="{Binding AskDiscard}"
                        Content="Discard"
                        Visibility="{Binding CanDiscard, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Discard what was entered at this point" />
                <Button Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Top"
                        Command="{Binding Close}"
                        AutomationProperties.Name="Close inspection point"
                        ToolTipService.ToolTip="Close">
                    <Viewbox Width="{StaticResource IconSizeS}" Height="{StaticResource IconSizeS}">
                        <PathIcon Data="{StaticResource IconFail}" />
                    </Viewbox>
                </Button>
            </Grid>

            <Border Style="{StaticResource TileSurface}"
                    Margin="{StaticResource GapTopS}"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding IsDiscardPending, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="{StaticResource SpaceS}">
                    <TextBlock Style="{StaticResource SupportingText}"
                               Text="Discard what you entered here? The reading, the call, the note and any photos are removed from this device." />
                    <Grid ColumnSpacing="{StaticResource SpaceS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource OutlinedButtonStyle}"
                                HorizontalAlignment="Stretch"
                                MinHeight="{StaticResource TouchTargetSize}"
                                Command="{Binding KeepDraft}"
                                Content="Keep"
                                AutomationProperties.Name="Keep what was entered" />
                        <Button Grid.Column="1"
                                Style="{StaticResource FilledButtonStyle}"
                                HorizontalAlignment="Stretch"
                                MinHeight="{StaticResource TouchTargetSize}"
                                Command="{Binding DiscardDraft}"
                                Content="Discard"
                                AutomationProperties.Name="Confirm discard" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The draft is not on the device: it could not be read, saved or discarded there. -->
            <TextBlock Text="{Binding DraftError}"
                       Style="{StaticResource ErrorText}"
                       Margin="{StaticResource GapTopS}"
                       AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding DraftError, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>

        <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{StaticResource ScrollBarGutter}">
            <StackPanel Spacing="{StaticResource SpaceM}">

                <TextBlock Text="{Binding SelectedPoint.Guidance}"
                           Style="{StaticResource SupportingText}" />

                <!-- Last reading and the band it is judged against, and the photos last recorded here -->
                <Border Style="{StaticResource TileSurface}">
                    <Grid ColumnSpacing="{StaticResource SpaceM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPoint.LatestReadingText}"
                                       Style="{StaticResource MetricLargeText}" />
                            <TextBlock Text="{Binding SelectedPoint.Unit}"
                                       Style="{StaticResource MetricSmallUnitText}"
                                       VerticalAlignment="Bottom"
                                       Margin="{StaticResource UnitBaselineGap}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceXXS}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPoint.ReadingType}"
                                       Style="{StaticResource FieldLabelText}" />
                            <TextBlock Style="{StaticResource SupportingText}">
                                <Run Text="Expected" />
                                <Run Text="{Binding SelectedPoint.ExpectedRange}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- A grid row with its own gap, so it costs nothing when the point has no photos. -->
                        <StackPanel x:Name="RecordedPhotos"
                                    DataContext="{Binding Evidence}"
                                    Grid.Row="1" Grid.ColumnSpan="2"
                                    Margin="{StaticResource GapTopM}"
                                    Spacing="{StaticResource SpaceS}"
                                    Visibility="{Binding HasLastEvidence, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabelText}">
                                <Run Text="Photos recorded" />
                                <Run Text="{Binding LastEvidence.Timestamp, Converter={StaticResource RelativeTime}}" />
                            </TextBlock>
                            <ItemsRepeater ItemsSource="{Binding LastPhotos}" TabFocusNavigation="Local">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="{StaticResource SpaceS}" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PhotoButtonStyle}"
                                                Command="{Binding DataContext.ViewEvidence, ElementName=RecordedPhotos}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Caption}"
                                                ToolTipService.ToolTip="{Binding Caption}">
                                            <!-- xaml-lint: allow card - image clip with a placeholder fill -->
                                            <Border Width="{StaticResource EvidenceThumbSize}"
                                                    Height="{StaticResource EvidenceThumbSize}"
                                                    CornerRadius="{StaticResource SmallRadius}"
                                                    Background="{ThemeResource SurfaceVariantBrush}">
                                                <Image Source="{Binding LocalUri}" Stretch="UniformToFill" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="{StaticResource SpaceS}">
                    <TextBlock Text="Notes" Style="{StaticResource FieldLabelText}" />
                    <TextBox Text="{Binding NoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="{StaticResource NotesMinHeight}"
                             MaxHeight="{StaticResource NotesMaxHeight}"
                             PlaceholderText="What did you see, hear or smell?"
                             AutomationProperties.Name="Inspection notes" />
                </StackPanel>

                <StackPanel x:Name="EvidenceSection" DataContext="{Binding Evidence}" Spacing="{StaticResource SpaceS}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Evidence" Style="{StaticResource FieldLabelText}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource SpaceXS}">
                            <!-- No hardware here to refuse the app, so the denial a real
                                 device would produce is reachable on demand. -->
                            <Button Style="{StaticResource TextButtonStyle}"
                                    MinHeight="{StaticResource TouchTargetSize}"
                                    Command="{Binding DenyCameraForDemo}"
                                    Content="Simulate denial"
                                    Visibility="{Binding IsCameraDenied, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    AutomationProperties.Name="Simulate denial of camera access" />
                            <Button Style="{StaticResource TextButtonStyle}"
                                    MinHeight="{StaticResource TouchTargetSize}"
                                    Command="{Binding AttachPhoto}"
                                    Content="Add photo"
                                    AutomationProperties.Name="Add photo evidence" />
                        </StackPanel>
                        <!-- An Add photo that attached nothing. A row of this grid rather than a
                             child of the spaced panel, which would keep a gap for it while hidden. -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding EvidenceError}"
                                   Style="{StaticResource ErrorText}"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Visibility="{Binding EvidenceError, Converter={StaticResource StringToVisibility}}" />
                    </Grid>

                    <!-- Camera denied: the only way back on a real device is settings. -->
                    <Border Style="{StaticResource TileSurface}"
                            Visibility="{Binding IsCameraDenied, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="{StaticResource SpaceS}">
                            <controls:StatusChip Severity="Critical" Text="Camera access denied" />
                            <TextBlock Style="{StaticResource SupportingText}"
                                       Text="TRACE cannot open the camera. Photos are optional — a written note also satisfies a failed point — but to attach one, allow camera access for TRACE in system settings." />
                            <Button Style="{StaticResource OutlinedButtonStyle}"
                                    HorizontalAlignment="Left"
                                    MinHeight="{StaticResource TouchTargetSize}"
                                    Command="{Binding GrantCameraFromSettings}"
                                    Content="Open settings"
                                    AutomationProperties.Name="Open settings for camera access" />
                        </StackPanel>
                    </Border>

                    <ItemsRepeater ItemsSource="{Binding Photos}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="{StaticResource SpaceS}" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TileSurface}" Padding="{StaticResource InsetS}">
                                    <Grid ColumnSpacing="{StaticResource SpaceM}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- xaml-lint: allow card - image clip with a placeholder fill -->
                                        <Border Width="{StaticResource EvidenceThumbSize}"
                                                Height="{StaticResource EvidenceThumbSize}"
                                                CornerRadius="{StaticResource SmallRadius}"
                                                Background="{ThemeResource SurfaceBrush}">
                                            <Image Source="{Binding LocalUri}"
                                                   Stretch="UniformToFill"
                                                   AutomationProperties.Name="{Binding Caption}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceXXS}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Caption}"
                                                       Style="{StaticResource BodyText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Type}" Style="{StaticResource SupportingText}" />
                                        </StackPanel>
                                        <!-- One photo off the draft; Discard still clears everything. -->
                                        <Button Grid.Column="2"
                                                Style="{StaticResource TextButtonStyle}"
                                                VerticalAlignment="Center"
                                                MinHeight="{StaticResource TouchTargetSize}"
                                                Command="{Binding DataContext.RemovePhoto, ElementName=EvidenceSection}"
                                                CommandParameter="{Binding Id}"
                                                Content="Remove"
                                                AutomationProperties.Name="Remove photo"
                                                AutomationProperties.HelpText="{Binding Caption}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border Style="{StaticResource TileSurface}"
                            Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Style="{StaticResource SupportingText}"
                                   Text="No evidence attached. A photo is required only when you are failing a point and have not written a note." />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Enter, decide, commit: always on screen. -->
        <StackPanel x:Name="Footer" Grid.Row="2" Spacing="{StaticResource SpaceM}" SizeChanged="OnPartResized">

            <StackPanel Spacing="{StaticResource SpaceS}">
                <TextBlock Text="New reading" Style="{StaticResource FieldLabelText}" />
                <TextBox Text="{Binding ReadingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         InputScope="Number"
                         MinHeight="{StaticResource TouchTargetSize}"
                         FontSize="{StaticResource ReadingFontSize}"
                         AutomationProperties.Name="New reading" />
            </StackPanel>

            <Grid ColumnSpacing="{StaticResource SpaceS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:DispositionButton Style="{StaticResource DispositionButtonStyle}"
                                                Kind="Pass"
                                                Label="Pass"
                                                IsChosen="{Binding IsPassChosen}"
                                                Command="{Binding SetPass}"
                                                AutomationProperties.Name="Record pass" />
                    <controls:DispositionButton Grid.Column="1"
                                                Style="{StaticResource DispositionButtonStyle}"
                                                Kind="Watch"
                                                Label="Watch"
                                                IsChosen="{Binding IsWatchChosen}"
                                                Command="{Binding SetWatch}"
                                                AutomationProperties.Name="Record watch" />
                    <controls:DispositionButton Grid.Column="2"
                                                Style="{StaticResource DispositionButtonStyle}"
                                                Kind="Fail"
                                                Label="Fail"
                                                IsChosen="{Binding IsFailChosen}"
                                                Command="{Binding SetFail}"
                                                AutomationProperties.Name="Record fail" />
                </Grid>

            <!--
                The confirmation of what was just recorded sits with the point it belongs
                to, rather than floating over the workspace where it would cover the very
                buttons the technician needs next.
            -->
            <Border Style="{StaticResource ConfirmationSurface}"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding HasConfirmation, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="{StaticResource SpaceS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Confirmation}"
                               Style="{StaticResource OnPrimaryContainerText}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{StaticResource TextButtonStyle}"
                            MinHeight="{StaticResource TouchTargetSize}"
                            Command="{Binding DismissConfirmation}"
                            Content="Dismiss"
                            AutomationProperties.Name="Dismiss confirmation" />
                </Grid>
            </Border>

            <Border Style="{StaticResource TileSurface}"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibility}}">
                <StackPanel Spacing="{StaticResource SpaceS}">
                    <controls:WrapPanel HorizontalSpacing="{StaticResource SpaceS}" VerticalSpacing="{StaticResource SpaceS}">
                        <controls:StatusChip Severity="Critical" Text="Fix this"
                                             Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVisibility}}" />
                        <controls:StatusChip Severity="Caution" Text="Out of range"
                                             Visibility="{Binding IsOutOfRange, Converter={StaticResource BoolToVisibility}}" />
                    </controls:WrapPanel>
                    <TextBlock Text="{Binding ValidationMessage}"
                               Style="{StaticResource SupportingText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- A completion that wrote nothing: the device could not write, or the point has gone. -->
            <TextBlock Text="{Binding CompletionError}"
                       Style="{StaticResource ErrorText}"
                       AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding CompletionError, Converter={StaticResource StringToVisibility}}" />

            <Button Style="{StaticResource FilledButtonStyle}"
                    HorizontalAlignment="Stretch"
                    MinHeight="{StaticResource TouchTargetSize}"
                    IsEnabled="{Binding CanComplete}"
                    Command="{Binding CompletePoint}"
                    Content="Complete point"
                    AutomationProperties.Name="Complete point" />

            <Button Style="{StaticResource OutlinedButtonStyle}"
                    HorizontalAlignment="Stretch"
                    MinHeight="{StaticResource TouchTargetSize}"
                    Command="{Binding OpenActionSheet}"
                    Content="Create corrective action"
                    Visibility="{Binding CanRaiseAction, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Create corrective action" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>

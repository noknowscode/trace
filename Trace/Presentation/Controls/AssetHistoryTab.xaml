<UserControl x:Class="Trace.Presentation.Controls.AssetHistoryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Trace.Presentation.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:utu="using:Uno.Toolkit.UI"
             IsTabStop="False">

    <!--
        The asset's History tab, bound to the workspace (AssetModel): every recorded inspection,
        newest first, with its photos. A photo opens in the workspace's viewer (ViewEvidence on
        the workspace, the FeedView's DataContext). One column at every width; the page caps it
        at ContentMaxWidth.
    -->
    <mvux:FeedView IsTabStop="False" Source="{Binding History}"
                   ProgressTemplate="{StaticResource FeedProgressTemplate}"
                   ErrorTemplate="{StaticResource FeedErrorTemplate}">
        <mvux:FeedView.ValueTemplate>
            <DataTemplate>
                <ScrollViewer>
                    <ItemsRepeater ItemsSource="{Binding Data}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="{StaticResource Space100}" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardSurface}" Padding="{StaticResource Space150Thickness}">
                                    <Grid ColumnSpacing="{StaticResource Space150}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource TimelineSpine}" />

                                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space050}">
                                            <TextBlock Text="{Binding PointLabel}"
                                                       Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="{Binding ReadingText}"
                                                       Style="{StaticResource CardTitleText}" />
                                            <TextBlock Text="{Binding Notes}"
                                                       Style="{StaticResource SupportingText}"
                                                       Visibility="{Binding Notes, Converter={StaticResource StringToVisibility}}" />
                                            <!-- The photos recorded with the inspection; each opens the viewer. -->
                                            <ItemsRepeater ItemsSource="{Binding Evidence}"
                                                           TabFocusNavigation="Local"
                                                           Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="{StaticResource Space100}" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource PhotoButtonStyle}"
                                                                Command="{utu:AncestorBinding AncestorType=mvux:FeedView, Path=DataContext.ViewEvidence}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding Caption}"
                                                                ToolTipService.ToolTip="{Binding Caption}">
                                                            <!-- xaml-lint: allow card - image clip with a placeholder fill -->
                                                            <Border Width="{StaticResource EvidencePhotoSize}"
                                                                    Height="{StaticResource EvidencePhotoSize}"
                                                                    CornerRadius="{StaticResource Radius200CornerRadius}"
                                                                    Background="{ThemeResource SurfaceVariantBrush}">
                                                                <Image Source="{Binding LocalUri}" Stretch="UniformToFill" />
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <controls:WrapPanel HorizontalSpacing="{StaticResource Space100}" VerticalSpacing="{StaticResource Space100}">
                                                <controls:StatusChip
                                                    Severity="{Binding Disposition, Converter={StaticResource ToSeverity}}"
                                                    Text="{Binding Disposition}" />
                                                <controls:StatusChip
                                                    Severity="{Binding SyncState, Converter={StaticResource ToSeverity}}"
                                                    Text="{Binding SyncState}" />
                                                <Border Style="{StaticResource ValueChip}">
                                                    <TextBlock Style="{StaticResource ChipValueText}"
                                                               Text="{Binding Technician}" />
                                                </Border>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Top"
                                                   Style="{StaticResource SupportingText}"
                                                   Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </DataTemplate>
        </mvux:FeedView.ValueTemplate>
        <mvux:FeedView.NoneTemplate>
            <DataTemplate>
                <Border Style="{StaticResource CardSurface}" VerticalAlignment="Top">
                    <StackPanel Spacing="{StaticResource Space100}">
                        <TextBlock Text="No inspections recorded"
                                   Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Style="{StaticResource SupportingText}"
                                   Text="Completed points appear here, newest first, with the reading, its photos and who recorded it." />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </mvux:FeedView.NoneTemplate>
    </mvux:FeedView>
</UserControl>

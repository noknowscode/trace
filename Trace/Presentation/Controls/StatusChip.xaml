<UserControl x:Class="Trace.Presentation.Controls.StatusChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             IsTabStop="False">

    <!--
        A status pill that always pairs colour with a mark and a word, so the state survives
        glare, gloves and colour-vision deficiency.

        Both the colour and the mark are switched by visual state rather than by a converter:
        state setters re-resolve ThemeResource on a light/dark switch, and the geometry stays
        in XAML where the string-to-Geometry conversion is free.
    -->
    <!-- xaml-lint: allow card - a status pill, not a card: utu:Chip is a toggle button that takes focus and announces as one, and the severity states repaint this shell. -->
    <Border x:Name="Shell"
            CornerRadius="{StaticResource ChipRadius}"
            Padding="{StaticResource ChipPadding}"
            MinHeight="{StaticResource ChipMinHeight}"
            VerticalAlignment="Center"
            HorizontalAlignment="Left">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeverityStates">
                <VisualState x:Name="Neutral">
                    <VisualState.Setters>
                        <Setter Target="Shell.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
                        <Setter Target="NeutralMark.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
                        <Setter Target="NeutralMark.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Positive">
                    <VisualState.Setters>
                        <Setter Target="Shell.Background" Value="{ThemeResource PrimaryContainerBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
                        <Setter Target="PositiveMark.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
                        <Setter Target="PositiveMark.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Shell.Background" Value="{ThemeResource TertiaryContainerBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource OnTertiaryContainerBrush}" />
                        <Setter Target="CautionMark.Foreground" Value="{ThemeResource OnTertiaryContainerBrush}" />
                        <Setter Target="CautionMark.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Shell.Background" Value="{ThemeResource ErrorContainerBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />
                        <Setter Target="CriticalMark.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />
                        <Setter Target="CriticalMark.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="Shell.Background" Value="{ThemeResource SecondaryContainerBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource OnSecondaryContainerBrush}" />
                        <Setter Target="InfoMark.Foreground" Value="{ThemeResource OnSecondaryContainerBrush}" />
                        <Setter Target="InfoMark.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
            <Viewbox Width="{StaticResource IconSizeXS}" Height="{StaticResource IconSizeXS}" VerticalAlignment="Center">
                <Grid x:Name="Marks" Width="24" Height="24">
                    <PathIcon x:Name="NeutralMark" Data="{StaticResource IconNote}" Visibility="Collapsed" />
                    <PathIcon x:Name="PositiveMark" Data="{StaticResource IconCheck}" Visibility="Collapsed" />
                    <PathIcon x:Name="CautionMark" Data="{StaticResource IconWatch}" Visibility="Collapsed" />
                    <PathIcon x:Name="CriticalMark" Data="{StaticResource IconFail}" Visibility="Collapsed" />
                    <PathIcon x:Name="InfoMark" Data="{StaticResource IconSync}" Visibility="Collapsed" />
                </Grid>
            </Viewbox>
            <TextBlock x:Name="Label"
                       Text="{Binding Text, ElementName=Root}"
                       Style="{StaticResource LabelMedium}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>

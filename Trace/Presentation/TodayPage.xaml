<Page x:Class="Trace.Presentation.TodayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Trace.Presentation.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

    <utu:SafeArea Insets="VisibleBounds" IsTabStop="False">
        <!--
            One column at every width. Narrow keeps 16 px sides for a phone; from Normal up the
            page breathes at 24; at Widest the column stops at ContentMaxWidth and centres, so a
            card never stretches across a monitor.
        -->
        <Grid RowSpacing="{StaticResource Space200}"
              Padding="{utu:Responsive Narrow={StaticResource Space200Thickness}, Normal={StaticResource Space300Thickness}}"
              MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PageHeader Eyebrow="ASSIGNED WORK"
                                 Title="Today"
                                 Supporting="{Binding Today}" />

            <!--
                Connection and outstanding work sit together above the round: the technician
                needs to know what the device is holding before deciding where to walk next.
            -->
            <Border Grid.Row="1" Style="{StaticResource TileSurface}">
                <StackPanel>
                    <!-- Status beside the controls from Normal; on a phone the controls drop below
                         the status, so neither squeezes the other's labels. -->
                    <Grid ColumnSpacing="{StaticResource Space150}"
                          RowSpacing="{utu:Responsive Narrow={StaticResource Space100}, Normal=0}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="{StaticResource Space050}"
                                    VerticalAlignment="Center"
                                    Grid.ColumnSpan="{utu:Responsive Narrow=2, Normal=1}">
                            <controls:WrapPanel HorizontalSpacing="{StaticResource Space100}" VerticalSpacing="{StaticResource Space100}">
                                <controls:StatusChip Severity="Positive"
                                                     Text="Online"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                                <controls:StatusChip Severity="Caution"
                                                     Text="Offline"
                                                     Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
                                <controls:StatusChip Severity="Info"
                                                     Text="{Binding PendingLabel}"
                                                     Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}" />
                            </controls:WrapPanel>
                            <TextBlock Style="{StaticResource SupportingText}"
                                       Text="Inspections always save on the device first."
                                       Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Device controls live together: whether this handset is working
                             offline, and which theme suits where it is being used. -->
                        <controls:WrapPanel Grid.Row="{utu:Responsive Narrow=1, Normal=0}"
                                            Grid.Column="{utu:Responsive Narrow=0, Normal=1}"
                                            Grid.ColumnSpan="{utu:Responsive Narrow=2, Normal=1}"
                                            HorizontalSpacing="{StaticResource Space100}"
                                            VerticalSpacing="{StaticResource Space100}"
                                            VerticalAlignment="Center">
                            <Button Style="{StaticResource OutlinedButtonStyle}"
                                    MinHeight="{StaticResource ControlHeightMediumLarge}"
                                    Command="{Binding ToggleConnection}"
                                    AutomationProperties.Name="{Binding ConnectionAction}">
                                <TextBlock Text="{Binding ConnectionAction}" />
                            </Button>
                            <!-- Named by their visible labels ("Go offline", "Light theme"): the label says what a press does. -->
                            <Button x:Name="ThemeToggle"
                                    Style="{StaticResource TextButtonStyle}"
                                    MinHeight="{StaticResource ControlHeightMediumLarge}"
                                    Command="{Binding ToggleTheme}"
                                    AutomationProperties.Name="{Binding ThemeAction}">
                                <TextBlock Text="{Binding ThemeAction}" />
                            </Button>
                        </controls:WrapPanel>
                    </Grid>
                    <!-- A theme switch that did not happen. Its own gap, so it costs nothing while hidden. -->
                    <TextBlock Text="{Binding ThemeError}"
                               Style="{StaticResource ErrorText}"
                               Margin="{StaticResource Space100TopThickness}"
                               AutomationProperties.LiveSetting="Assertive"
                               Visibility="{Binding ThemeError, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <mvux:FeedView IsTabStop="False" Grid.Row="2"
                           Source="{Binding Assignments}"
                           ErrorTemplate="{StaticResource FeedErrorTemplate}">
                <mvux:FeedView.ValueTemplate>
                    <DataTemplate>
                        <ScrollViewer>
                            <ItemsRepeater ItemsSource="{Binding Data}" TabFocusNavigation="Local">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="{StaticResource Space150}" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButtonStyle}"
                                                AutomationProperties.Name="{Binding Designation}"
                                                uen:Navigation.Request="../Asset"
                                                uen:Navigation.Data="{Binding}">
                                            <controls:AssetCardContent />
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </DataTemplate>
                </mvux:FeedView.ValueTemplate>

                <mvux:FeedView.ProgressTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="{StaticResource Space150}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressRing IsActive="True"
                                          Width="{StaticResource IconSizeLarge}"
                                          Height="{StaticResource IconSizeLarge}"
                                          AutomationProperties.Name="Loading your round" />
                            <TextBlock Text="Loading your round…" Style="{StaticResource SupportingText}" />
                        </StackPanel>
                    </DataTemplate>
                </mvux:FeedView.ProgressTemplate>

                <mvux:FeedView.NoneTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardSurface}" VerticalAlignment="Top">
                            <StackPanel Spacing="{StaticResource Space100}">
                                <TextBlock Text="Nothing assigned today"
                                           Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Style="{StaticResource SupportingText}"
                                           Text="Your round is clear. Scan an asset tag or browse Assets to inspect something outside the schedule." />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </mvux:FeedView.NoneTemplate>
            </mvux:FeedView>
        </Grid>
    </utu:SafeArea>
</Page>

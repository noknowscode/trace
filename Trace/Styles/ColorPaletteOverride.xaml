<!--
    TRACE's palette: the one place its brand colours live. MaterialToolkitTheme reads it through
    ThemeColors.OverrideSource (App.xaml), generates every role brush from it (PrimaryBrush, OnSurfaceBrush,
    ErrorContainerBrush and their Hover/Pressed/Medium/Low… variants), and every Material control and page follows.
    Uno Platform Studio's Themes tab edits this file.

    The design gives every role in both themes, so all 33 keys are set and no generated colour shows. The legacy
    Material 2 variants take the design's own darker and lighter tones of Primary and Secondary, and the shadow is
    the design's black at the 20 % the theme's elevation expects. Light is the office review theme; Default is
    Dark, TRACE's working default for field use (App.xaml).
    Colours with no palette role (the Success and Watch statuses, the scrim, the 3D view's fill light and the
    equipment paint) are App.xaml's, in its Light and Default theme dictionaries.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#0B6B47</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#9FF2CB</Color>
      <Color x:Key="OnPrimaryContainerColor">#002517</Color>
      <Color x:Key="PrimaryInverseColor">#6EE7AE</Color>
      <Color x:Key="PrimaryVariantDarkColor">#002517</Color>
      <Color x:Key="PrimaryVariantLightColor">#6EE7AE</Color>
      <Color x:Key="SecondaryColor">#00567C</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#C5E7FF</Color>
      <Color x:Key="OnSecondaryContainerColor">#001E2E</Color>
      <Color x:Key="SecondaryVariantDarkColor">#001E2E</Color>
      <Color x:Key="SecondaryVariantLightColor">#7FC9FF</Color>
      <Color x:Key="TertiaryColor">#7A5200</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#FFDEA6</Color>
      <Color x:Key="OnTertiaryContainerColor">#271900</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#FFDAD5</Color>
      <Color x:Key="OnErrorContainerColor">#410003</Color>
      <Color x:Key="BackgroundColor">#EFF4F1</Color>
      <Color x:Key="OnBackgroundColor">#111C19</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#111C19</Color>
      <Color x:Key="SurfaceVariantColor">#E4ECE8</Color>
      <Color x:Key="OnSurfaceVariantColor">#47605A</Color>
      <Color x:Key="SurfaceInverseColor">#2C3633</Color>
      <Color x:Key="OnSurfaceInverseColor">#EFF4F1</Color>
      <Color x:Key="SurfaceTintColor">#0B6B47</Color>
      <Color x:Key="OutlineColor">#77908A</Color>
      <Color x:Key="OutlineVariantColor">#C7D6D1</Color>
      <Color x:Key="ShadowColor">#33000000</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#6EE7AE</Color>
      <Color x:Key="OnPrimaryColor">#00281A</Color>
      <Color x:Key="PrimaryContainerColor">#17352C</Color>
      <Color x:Key="OnPrimaryContainerColor">#9DF5CC</Color>
      <Color x:Key="PrimaryInverseColor">#0C6B48</Color>
      <Color x:Key="PrimaryVariantDarkColor">#0C6B48</Color>
      <Color x:Key="PrimaryVariantLightColor">#9DF5CC</Color>
      <Color x:Key="SecondaryColor">#7FC9FF</Color>
      <Color x:Key="OnSecondaryColor">#00354F</Color>
      <Color x:Key="SecondaryContainerColor">#123449</Color>
      <Color x:Key="OnSecondaryContainerColor">#C4E5FF</Color>
      <Color x:Key="SecondaryVariantDarkColor">#00567C</Color>
      <Color x:Key="SecondaryVariantLightColor">#C4E5FF</Color>
      <Color x:Key="TertiaryColor">#FFC65C</Color>
      <Color x:Key="OnTertiaryColor">#3A2600</Color>
      <Color x:Key="TertiaryContainerColor">#46320A</Color>
      <Color x:Key="OnTertiaryContainerColor">#FFE0A6</Color>
      <Color x:Key="ErrorColor">#FF7A70</Color>
      <Color x:Key="OnErrorColor">#4E0A05</Color>
      <Color x:Key="ErrorContainerColor">#5A1A15</Color>
      <Color x:Key="OnErrorContainerColor">#FFD5D0</Color>
      <Color x:Key="BackgroundColor">#08100F</Color>
      <Color x:Key="OnBackgroundColor">#E8F3EE</Color>
      <Color x:Key="SurfaceColor">#101A18</Color>
      <Color x:Key="OnSurfaceColor">#E8F3EE</Color>
      <Color x:Key="SurfaceVariantColor">#17231F</Color>
      <Color x:Key="OnSurfaceVariantColor">#9CB2AB</Color>
      <Color x:Key="SurfaceInverseColor">#E8F3EE</Color>
      <Color x:Key="OnSurfaceInverseColor">#0C1614</Color>
      <Color x:Key="SurfaceTintColor">#6EE7AE</Color>
      <Color x:Key="OutlineColor">#2C403A</Color>
      <Color x:Key="OutlineVariantColor">#1E2E29</Color>
      <Color x:Key="ShadowColor">#33000000</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

<Application x:Class="Trace.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       RequestedTheme="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          xmlns:utum="using:Uno.Toolkit.UI.Material"
          xmlns:ut="using:Uno.Themes">
          <!-- Uno Themes 9: colour overrides live on Colors (ColorOverrideSource is deprecated). -->
          <utum:MaterialToolkitTheme.Colors>
            <ut:ThemeColors OverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
          </utum:MaterialToolkitTheme.Colors>
        </utum:MaterialToolkitTheme>

        <!-- TRACE tokens and shared surfaces. Merged after Material so they can build on it. -->
        <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/ColorTokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Converters.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Markers.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>

<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- Uno.Sdk skips the heads the build OS can't build (iOS off macOS, WinAppSDK off Windows). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.26100;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!-- One head at a time (CI, RID-specific publish): -p:TraceTargetFrameworks=net10.0-desktop. -->
    <TargetFrameworks Condition="'$(TraceTargetFrameworks)' != ''">$(TraceTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Trace</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.unoplatform.trace</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Trace</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Trace powered by Uno Platform.</Description>
    <!-- Uno0001 = member not implemented in Uno Platform: fail the build instead of shipping a silent no-op. -->
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Skia;
      Dsp;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      Localization;
      Navigation;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
    <!--
      Uno.Sdk 7.0.0-dev.115 bundles Hot Design 2.0.0-dev.31 and App MCP 2.0.0-dev.18, whose clients still reference
      Uno.UI.Lottie, an assembly Uno 7 no longer ships: every Debug launch crashes in GlobalStaticResources. Both stay off
      (Debug only; Release never had them) until a dev build drops the reference. Delete these three lines then.
    -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <DefineConstants>$(DefineConstants);NO_UNO_STUDIO</DefineConstants>
  </PropertyGroup>

  <!--
    WinAppSDK: an x64 or ARM64 build, never AnyCPU, for the Skia natives behind the equipment view's SKXamlCanvas.
    Uno 7's WinUI libraries are built against WinRT.Runtime 2.3.1, and the SDK's default Windows projection carries
    2.2.0 (CS1705). Projection revision .87 carries 2.3.1: 10.0.19041.87 is the CI-proven pin on the 19041 heads,
    and the 10.0.26100.87 package ships the same WinRT.Runtime 2.3.1 for this head's 26100 target.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Core" />
  </ItemGroup>

</Project>

<!--
  Uno 6.7 test build: Uno.Themes 7.1 does not generate the Space*, Radius*, ControlHeight* and IconSize* tokens that
  Uno 7's themes create at runtime. These are the keys TRACE uses, at the Uno 7 defaults (DefaultSpacing 8,
  DefaultCornerRadius 4, Regular density): Space{n} = 8 x n/100, Radius{n} = 4 x n/100. Delete this file on Uno 7.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="ControlHeightMediumLarge">44</x:Double>
  <x:Double x:Key="IconSizeLarge">32</x:Double>
  <x:Double x:Key="IconSizeSmall">16</x:Double>
  <CornerRadius x:Key="Radius050CornerRadius">2</CornerRadius>
  <CornerRadius x:Key="Radius200CornerRadius">8</CornerRadius>
  <CornerRadius x:Key="Radius300CornerRadius">12</CornerRadius>
  <CornerRadius x:Key="Radius400CornerRadius">16</CornerRadius>
  <CornerRadius x:Key="Radius500CornerRadius">20</CornerRadius>
  <x:Double x:Key="Space025">2</x:Double>
  <Thickness x:Key="Space025TopThickness">0,2,0,0</Thickness>
  <x:Double x:Key="Space050">4</x:Double>
  <Thickness x:Key="Space050BottomThickness">0,0,0,4</Thickness>
  <Thickness x:Key="Space050RightThickness">0,0,4,0</Thickness>
  <Thickness x:Key="Space050Thickness">4,4,4,4</Thickness>
  <x:Double x:Key="Space075">6</x:Double>
  <x:Double x:Key="Space100">8</x:Double>
  <Thickness x:Key="Space100HorizontalThickness">8,0,8,0</Thickness>
  <Thickness x:Key="Space100Thickness">8,8,8,8</Thickness>
  <Thickness x:Key="Space100TopThickness">0,8,0,0</Thickness>
  <x:Double x:Key="Space150">12</x:Double>
  <Thickness x:Key="Space150Thickness">12,12,12,12</Thickness>
  <Thickness x:Key="Space150TopThickness">0,12,0,0</Thickness>
  <x:Double x:Key="Space200">16</x:Double>
  <Thickness x:Key="Space200Thickness">16,16,16,16</Thickness>
  <x:Double x:Key="Space300">24</x:Double>
  <Thickness x:Key="Space300Thickness">24,24,24,24</Thickness>
</ResourceDictionary>

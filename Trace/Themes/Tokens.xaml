<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TRACE layout tokens. Colour lives in the Material palette (Styles/ColorPaletteOverride)
        and in Themes/ColorTokens.xaml, type comes from the Material type scale, and this file
        carries the geometry and timing the design graph fixes. Pages and controls reference
        these keys rather than literal spacing, insets, sizes or radii.

        WinUI cannot resolve a StaticResource across sibling merged dictionaries while the
        application dictionary loads, so every value here is a literal, never a reference.
    -->

    <!-- Spacing scale: 4 / 8 / 12 / 16 / 24 / 32, plus the 2 between an overline and its title. -->
    <x:Double x:Key="SpaceXXS">2</x:Double>
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="SpaceXXL">32</x:Double>

    <!-- Insets on the same scale. -->
    <Thickness x:Key="InsetS">8</Thickness>
    <Thickness x:Key="InsetM">12</Thickness>
    <Thickness x:Key="InsetL">16</Thickness>
    <Thickness x:Key="GapTopXXS">0,2,0,0</Thickness>
    <Thickness x:Key="GapTopS">0,8,0,0</Thickness>
    <Thickness x:Key="GapTopM">0,12,0,0</Thickness>
    <Thickness x:Key="GapBottomXS">0,0,0,4</Thickness>
    <!-- Room for a vertical scroll bar beside scrolling content. -->
    <Thickness x:Key="ScrollBarGutter">0,0,4,0</Thickness>
    <!-- One hairline on the trailing edge: the rail's divider. -->
    <Thickness x:Key="DividerEnd">0,0,1,0</Thickness>

    <Thickness x:Key="TilePadding">12</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <!-- A card that holds a single compact row: the point strip, the plates on the machine. -->
    <Thickness x:Key="CompactCardPadding">12,8</Thickness>
    <Thickness x:Key="ChipPadding">8,4</Thickness>

    <!--
        Page and sheet insets per responsive category (utu:Responsive with the Toolkit's default
        breakpoints: Narrow below 600, Normal 600, Wide 800, Widest 1080). A phone keeps 16 px
        sides; from Normal up the page breathes at 24.
    -->
    <Thickness x:Key="PagePadding">16</Thickness>
    <Thickness x:Key="PagePaddingWide">24</Thickness>
    <Thickness x:Key="SheetPadding">16</Thickness>
    <Thickness x:Key="SheetPaddingWide">24</Thickness>

    <!--
        Content widths. Lists and forms stop growing at Widest and centre in the page; the asset
        workspace stops later because the machine view uses the room.
    -->
    <x:Double x:Key="ContentMaxWidth">960</x:Double>
    <x:Double x:Key="ReviewMaxWidth">1280</x:Double>
    <x:Double x:Key="WorkspaceMaxWidth">1600</x:Double>
    <x:Double x:Key="FormMaxWidth">640</x:Double>
    <x:Double x:Key="DialogMaxWidth">520</x:Double>
    <!-- The asset tab strip from Normal up: four tabs at a comfortable width, not spread across a monitor. -->
    <x:Double x:Key="AssetTabsMaxWidth">520</x:Double>
    <!-- The docked point inspector: Wide (a tablet in landscape) and Widest (a workstation). -->
    <x:Double x:Key="InspectorWidthWide">360</x:Double>
    <x:Double x:Key="InspectorWidthWidest">400</x:Double>
    <!-- The equipment view never gets shorter than this, whatever the window. -->
    <x:Double x:Key="SceneMinHeight">260</x:Double>

    <!--
        Corner radii are written as explicit values, never as an oversized "pill" number:
        the Skia renderer reduces radius per axis rather than clamping to a circle, so 999 on
        a 28-high control renders as an oval.
    -->
    <CornerRadius x:Key="SmallRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>
    <CornerRadius x:Key="SheetRadius">14</CornerRadius>
    <CornerRadius x:Key="CardRadius">18</CornerRadius>
    <CornerRadius x:Key="ChipRadius">12</CornerRadius>
    <CornerRadius x:Key="SpineRadius">2</CornerRadius>

    <!-- Gloved-hand minimum. Every interactive target is sized to at least this. -->
    <x:Double x:Key="TouchTargetSize">44</x:Double>
    <x:Double x:Key="ChipMinHeight">26</x:Double>

    <!-- Glyph sizes. Glyphs are 24-unit paths hosted in a Viewbox of this size. -->
    <x:Double x:Key="IconSizeXS">12</x:Double>
    <x:Double x:Key="IconSizeS">14</x:Double>
    <x:Double x:Key="IconSizeM">18</x:Double>
    <x:Double x:Key="ProgressSize">32</x:Double>
    <x:Double x:Key="ViewfinderGlyphSize">96</x:Double>
    <x:Double x:Key="ViewfinderGlyphOpacity">0.32</x:Double>
    <x:Double x:Key="ViewfinderMinHeight">220</x:Double>

    <!-- Field sizes in the point inspector. -->
    <x:Double x:Key="ReadingFontSize">20</x:Double>
    <x:Double x:Key="NotesMinHeight">88</x:Double>
    <x:Double x:Key="NotesMaxHeight">160</x:Double>
    <x:Double x:Key="EvidenceThumbSize">64</x:Double>
    <!-- A recorded photo in History: large enough to read a seal weep or a witness mark. -->
    <x:Double x:Key="EvidencePhotoSize">96</x:Double>
    <!-- The photo viewer: the whole picture, no wider than this, centred over the workspace. -->
    <x:Double x:Key="ViewerMaxWidth">720</x:Double>
    <!-- Sits a unit on the baseline of the large reading beside it. -->
    <Thickness x:Key="UnitBaselineGap">0,0,0,4</Thickness>

    <!--
        The navigation rail's host height. The vertical bar divides whatever height it is given
        equally between its items: 360 gives each of the five a 72 high slot.
    -->
    <x:Double x:Key="RailHeight">360</x:Double>

    <!-- Motion supports a state change; it never delays the next reading. -->
    <Duration x:Key="FastDuration">0:0:0.12</Duration>
    <Duration x:Key="StandardDuration">0:0:0.22</Duration>

</ResourceDictionary>

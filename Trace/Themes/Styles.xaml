<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Trace.Presentation.Controls"
                    xmlns:mvux="using:Uno.Extensions.Reactive.UI"
                    xmlns:utu="using:Uno.Toolkit.UI">

    <!--
        Shared surfaces and text roles. The surface hierarchy from the design graph reads as
        canvas (page background) → raised pane (card) → interactive tile → transient sheet,
        and each level is one step of elevation expressed as background plus outline rather
        than as a drop shadow, which stays legible in glare.
    -->

    <Style x:Key="CardSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="TileSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceVariantBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="{StaticResource TilePadding}" />
    </Style>

    <Style x:Key="SheetSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SheetRadius}" />
        <Setter Property="Padding" Value="{StaticResource SheetPadding}" />
    </Style>

    <!--
        Overline label above a title. Set in caps in the content rather than by letterspacing:
        CharacterSpacing is a no-op on the Skia text stack and fails silently.
    -->
    <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
        <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SupportingText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelText" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Text roles carry their own colour. A ThemeResource assigned straight onto an
        element's Foreground is a local value and does not re-resolve when the theme
        changes, while the same reference inside a Style setter does — so every foreground
        in this app comes from a style, and a light/dark switch stays correct.
    -->
    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardTitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PanelTitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmall}">
        <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ChipValueText" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="Foreground" Value="{ThemeResource ErrorBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OnPrimaryContainerText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MetricLargeText" TargetType="TextBlock" BasedOn="{StaticResource HeadlineMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="MetricSmallUnitText" TargetType="TextBlock" BasedOn="{StaticResource TitleSmall}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    </Style>

    <!--
        A whole card that is one target. Written as a Button rather than a tapped Border so
        it reaches keyboard activation, focus visuals and the disabled state for free — all
        four are explicit requirements of the definition of done.
    -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" />
                        </Grid.RenderTransform>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Opacity" Value="0.12" />
                                        <Setter Target="PressScale.ScaleX" Value="0.98" />
                                        <Setter Target="PressScale.ScaleY" Value="0.98" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch" />
                        </Border>

                        <Border x:Name="StateOverlay"
                                Background="{ThemeResource OnSurfaceBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />

                        <Border x:Name="FocusRing"
                                BorderBrush="{ThemeResource PrimaryBrush}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Margin="-2"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The equipment viewport is lit by the room it is drawn into. These have to come from a
        Style: the renderer reads the brushes off the control, and a ThemeResource resolves
        per theme only when it arrives through a setter.
    -->
    <Style x:Key="AssetSceneViewStyle" TargetType="controls:AssetSceneView">
        <Setter Property="SceneBackground" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="GroundShadow" Value="{ThemeResource SceneGroundShadowBrush}" />
        <Setter Property="KeyLight" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="FillLight" Value="{ThemeResource SceneFillLightBrush}" />
    </Style>

    <!--
        Feed states shared by every data-driven view. Inside a FeedView template the DataContext
        is the feed's state (in the error template, the exception), so Try again walks up to the
        FeedView and calls Retry on the page model behind it (FeedRecovery). FeedView's own
        Refresh would do nothing here: the feeds are live watches, which MVUX does not restart.
    -->
    <DataTemplate x:Key="FeedProgressTemplate">
        <ProgressRing IsActive="True"
                      Width="{StaticResource ProgressSize}"
                      Height="{StaticResource ProgressSize}"
                      Margin="{StaticResource InsetL}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      AutomationProperties.Name="Loading" />
    </DataTemplate>

    <DataTemplate x:Key="FeedErrorTemplate">
        <Border Style="{StaticResource CardSurface}" VerticalAlignment="Top">
            <StackPanel Spacing="{StaticResource SpaceS}">
                <controls:StatusChip Severity="Critical" Text="Could not read this device's records" />
                <TextBlock Style="{StaticResource SupportingText}"
                           Text="Nothing was changed. Try again; if it keeps failing, restart TRACE." />
                <Button Style="{StaticResource OutlinedButtonStyle}"
                        HorizontalAlignment="Left"
                        MinHeight="{StaticResource TouchTargetSize}"
                        Content="Try again"
                        Command="{utu:AncestorBinding AncestorType=mvux:FeedView, Path=DataContext.Retry}"
                        AutomationProperties.Name="Try again to read the records" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A value shown as a chip without a status: progress, due time, assignee. -->
    <Style x:Key="ValueChip" TargetType="Border" BasedOn="{StaticResource TileSurface}">
        <Setter Property="Padding" Value="{StaticResource ChipPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource ChipMinHeight}" />
    </Style>

    <!-- A plate laid over the equipment view: the nameplate and the drag hint. -->
    <Style x:Key="ScenePlate" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="{StaticResource CompactCardPadding}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- What was just recorded, beside the point it belongs to. -->
    <Style x:Key="ConfirmationSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PrimaryContainerBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="{StaticResource TilePadding}" />
    </Style>

    <!-- The spine down the left of a history entry. -->
    <Style x:Key="TimelineSpine" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="{StaticResource SpineRadius}" />
        <Setter Property="Background" Value="{ThemeResource OutlineBrush}" />
    </Style>

    <!-- An icon-only button: a glyph in a square gloved-hand target. -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="Width" Value="{StaticResource TouchTargetSize}" />
        <Setter Property="Height" Value="{StaticResource TouchTargetSize}" />
        <Setter Property="Padding" Value="0" />
    </Style>

</ResourceDictionary>

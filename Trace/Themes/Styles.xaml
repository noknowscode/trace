<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared surfaces and text roles. The surface hierarchy from the design graph reads as
        canvas (page background) → raised pane (card) → interactive tile → transient sheet,
        and each level is one step of elevation expressed as background plus outline rather
        than as a drop shadow, which stays legible in glare.
    -->

    <Style x:Key="CardSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="TileSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceVariantBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="{StaticResource TilePadding}" />
    </Style>

    <Style x:Key="SheetSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SheetRadius}" />
        <Setter Property="Padding" Value="{StaticResource SheetPadding}" />
    </Style>

    <!--
        Overline label above a title. Set in caps in the content rather than by letterspacing:
        CharacterSpacing is a no-op on the Skia text stack and fails silently.
    -->
    <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
        <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SupportingText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelText" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        A whole card that is one target. Written as a Button rather than a tapped Border so
        it reaches keyboard activation, focus visuals and the disabled state for free — all
        four are explicit requirements of the definition of done.
    -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" />
                        </Grid.RenderTransform>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Opacity" Value="0.12" />
                                        <Setter Target="PressScale.ScaleX" Value="0.98" />
                                        <Setter Target="PressScale.ScaleY" Value="0.98" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch" />
                        </Border>

                        <Border x:Name="StateOverlay"
                                Background="{ThemeResource OnSurfaceBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />

                        <Border x:Name="FocusRing"
                                BorderBrush="{ThemeResource PrimaryBrush}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Margin="-2"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Machine surfaces for the spatial view. The body reads as a solid object by tinting
        the on-surface role rather than by using a fixed grey, so the machine stays legible
        in both themes. Recesses and highlights are plain black and white at low alpha
        because shadow and shine are dark and bright in every theme.
    -->
    <Style x:Key="MachineBodyRect" TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>

    <Style x:Key="MachineEdgeRect" TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="Opacity" Value="0.42" />
    </Style>

    <Style x:Key="MachineBodyEllipse" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>

    <Style x:Key="MachineEdgeEllipse" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="Opacity" Value="0.42" />
    </Style>

    <Style x:Key="MachineRecessRect" TargetType="Rectangle">
        <Setter Property="Fill" Value="Black" />
        <Setter Property="Opacity" Value="0.26" />
    </Style>

    <Style x:Key="MachineRecessEllipse" TargetType="Ellipse">
        <Setter Property="Fill" Value="Black" />
        <Setter Property="Opacity" Value="0.26" />
    </Style>

    <Style x:Key="MachineHighlightRect" TargetType="Rectangle">
        <Setter Property="Fill" Value="White" />
        <Setter Property="Opacity" Value="0.08" />
    </Style>

    <!-- Count on a navigation icon. Radius is half the height so Skia draws a circle. -->
    <Style x:Key="CountBadge" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ErrorBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-6,-10,0" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
        <Setter Property="Foreground" Value="{ThemeResource OnErrorBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The number a technician reads at arm's length in a mechanical room. -->
    <Style x:Key="MetricValueText" TargetType="TextBlock" BasedOn="{StaticResource DisplaySmall}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="MetricUnitText" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    </Style>

</ResourceDictionary>
